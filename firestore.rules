rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email != null && (
          request.auth.token.email.lower() == 'waheedsamaha8@gmail.com' ||
          (request.auth.token.email_verified == true && exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin directory (strictly protected)
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Buildings: Master Multi-tenant collections
    match /buildings/{buildingId} {
      allow read: if true;
      allow write: if isValidId(buildingId);

      match /{subcollection=**} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Residents Directory
    match /residents/{residentId} {
      allow read: if true;
      allow create, update, delete: if isValidId(residentId);
    }

    // Payments Records
    match /payments/{paymentId} {
      allow read: if true;
      allow create, update, delete: if isValidId(paymentId);
    }

    // Expenses Records
    match /expenses/{expenseId} {
      allow read: if true;
      allow create, update, delete: if isValidId(expenseId);
    }

    // Chat Messages
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create, update, delete: if isValidId(messageId);
    }

    // Public Complaints and Suggestions
    match /public_complaints/{complaintId} {
      allow read: if true;
      allow create, update, delete: if isValidId(complaintId);
    }

    // Maintenance Tickets
    match /maintenance/{maintenanceId} {
      allow read: if true;
      allow create, update, delete: if isValidId(maintenanceId);
    }

    // Polls & Voting
    match /polls/{pollId} {
      allow read: if true;
      allow create, update, delete: if isValidId(pollId);
    }

    // Board Decisions
    match /admin_decisions/{decisionId} {
      allow read: if true;
      allow create, update, delete: if isValidId(decisionId);
    }

    // Events Calendar
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isValidId(eventId);
    }

    // Craftsmen Directory
    match /craftsmen/{craftsmanId} {
      allow read: if true;
      allow create, update, delete: if isValidId(craftsmanId);
    }

    // Join Requests
    match /join_requests/{requestId} {
      allow read: if true;
      allow create, update, delete: if isValidId(requestId);
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isValidId(notificationId);
    }

    // App Configuration & Association Rules
    match /config/{configId} {
      allow read: if true;
      allow create, update, delete: if isValidId(configId);
    }

    match /rules/{rulesId} {
      allow read: if true;
      allow create, update, delete: if isValidId(rulesId);
    }
  }
}
