rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email != null && (
          request.auth.token.email.lower() == 'waheedsamaha8@gmail.com' ||
          (request.auth.token.email_verified == true && exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin directory (strictly protected)
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Buildings: Master Multi-tenant collections
    match /buildings/{buildingId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuthenticated() && isValidId(buildingId));

      match /{subcollection=**} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Residents Directory
    match /residents/{residentId} {
      allow read: if true;
      allow write: if isValidId(residentId) && (
        isAdmin() ||
        isAuthenticated() ||
        (incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 200)
      );
    }

    // Payments Records
    match /payments/{paymentId} {
      allow read: if true;
      allow write: if isValidId(paymentId) && (
        isAdmin() ||
        isAuthenticated() ||
        (incoming().amount is number && incoming().amount >= 0)
      );
    }

    // Expenses Records
    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if isValidId(expenseId) && (
        isAdmin() ||
        isAuthenticated() ||
        (incoming().amount is number && incoming().amount >= 0)
      );
    }

    // Chat Messages
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId) && (
        incoming().text is string && 
        incoming().text.size() > 0 && 
        incoming().text.size() <= 3000
      );
      allow update, delete: if isValidId(messageId);
    }

    // Public Complaints and Suggestions
    match /public_complaints/{complaintId} {
      allow read: if true;
      allow create: if isValidId(complaintId) && (
        incoming().title is string &&
        incoming().title.size() > 0 &&
        incoming().title.size() <= 300
      );
      allow update, delete: if isValidId(complaintId);
    }

    // Maintenance Tickets
    match /maintenance/{maintenanceId} {
      allow read: if true;
      allow write: if isValidId(maintenanceId);
    }

    // Polls & Voting
    match /polls/{pollId} {
      allow read: if true;
      allow write: if isValidId(pollId);
    }

    // Board Decisions
    match /admin_decisions/{decisionId} {
      allow read: if true;
      allow write: if isValidId(decisionId);
    }

    // Events Calendar
    match /events/{eventId} {
      allow read: if true;
      allow write: if isValidId(eventId);
    }

    // Craftsmen Directory
    match /craftsmen/{craftsmanId} {
      allow read: if true;
      allow write: if isValidId(craftsmanId);
    }

    // Join Requests
    match /join_requests/{requestId} {
      allow read: if true;
      allow create: if isValidId(requestId) && (
        incoming().email is string &&
        incoming().email.size() > 0 &&
        incoming().email.size() <= 150
      );
      allow update, delete: if isValidId(requestId);
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isValidId(notificationId);
    }

    // App Configuration & Association Rules
    match /config/{configId} {
      allow read: if true;
      allow write: if isValidId(configId);
    }

    match /rules/{rulesId} {
      allow read: if true;
      allow write: if isValidId(rulesId);
    }
  }
}
